{
  "firestore": {
    "database": "(default)",
    "location": "europe-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/sitemap.xml",  "destination": "/sitemap.xml" },
      { "source": "/robots.txt",   "destination": "/robots.txt" },
      { "source": "/portfolio/**", "destination": "/index.html" },
      { "source": "/review/**",    "destination": "/index.html" },
      { "source": "/faq",          "destination": "/faq.html" },
      { "source": "/contact",      "destination": "/contact.html" },
      { "source": "/privacy",      "destination": "/privacy.html" },
      { "source": "/terms",        "destination": "/terms.html" },
      { "source": "/refund",       "destination": "/refund.html" },
      { "source": "/founder",      "destination": "/founder.html" },
      { "source": "/delete-account", "destination": "/delete-account.html" },
      { "source": "**",            "destination": "/app.html" }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "TailorPady",
        "supportEmail": "uchenduuchenna7@gmail.com"
      }
    }
  }
}
