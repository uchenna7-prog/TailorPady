rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['referralCode', 'referredBy', 'createdAt'])
        && request.resource.data.referredBy == null;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['referralCode', 'referredBy', 'createdAt']);

      match /settings/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if docId != 'premium'
          && request.auth != null && request.auth.uid == uid;
      }

      match /subscriptionPayments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /tailorProfile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /publicProfile/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /galleryPhotos/{photoId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /galleryGarmentTypes/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /portfolioSettings/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /customers/{customerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /measurements/{measurementId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /invoices/{invoiceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /payments/{paymentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /receipts/{receiptId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /usage/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /agentMessages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /agentDrafts/{draftId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /agentScheduled/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /appointments/{appointmentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /gallery/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /inventory/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /revenueGoal/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /pushSubscriptions/{subId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /reviews/{reviewId} {
        allow read: if (request.auth != null && request.auth.uid == uid)
          || resource.data.status == 'approved';
        allow write: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth == null
          && reviewId == request.resource.data.token
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() > 0
          && request.resource.data.review is string
          && request.resource.data.review.size() > 0
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.status == 'pending';
      }

      match /reviewContacts/{reviewId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /reviewOrders/{token} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /referrals/{referralId} {
      allow read: if request.auth != null
        && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.referredUid == request.auth.uid
        && request.resource.data.referrerUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /bugReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}